---
import { Image, getImage } from "astro:assets";
import Base from "../../layouts/Base.astro";
import ProductCard from "../../components/ProductCard.astro";
import SizePicker from "../../components/SizePicker.tsx";
import AvisSheet from "../../components/AvisSheet.tsx";
import { BUILD_NOW, getLive, getProducts, isUpcoming, related, type Product } from "../../lib/catalog";
import { dateLabel } from "../../lib/drop";
import { toPiece } from "../../lib/pieces";
import { available, fcfa, waLink } from "../../lib/shop";
import { DROP, SHOP } from "../../config";

export async function getStaticPaths() {
  const [all, live] = await Promise.all([getProducts(), getLive()]);
  return all.map((p) => ({ params: { slug: p.id }, props: { product: p, live } }));
}
interface Props { product: Product; live: Product[] }
const { product: p, live } = Astro.props;
// A piece waiting for its drop has a page (cards link to it the second it opens), locked until then.
const upcoming = isUpcoming(p, BUILD_NOW);
const drop = upcoming && p.data.drop
  ? { at: p.data.drop.getTime(), label: dateLabel(p.data.drop), notify: DROP.channel || waLink(`Bonjour ${SHOP.name} ! Préviens-moi à l'ouverture du drop pour « ${p.data.name} » 🙏`) }
  : undefined;
const piece = await toPiece(p);
const url = new URL(`/produit/${p.id}`, Astro.site).href;
const og = await getImage({ src: p.data.image, width: 476, format: "jpg" });
const inStock = available(p.data.stock).length > 0;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: p.data.name,
  description: p.data.description,
  image: new URL(og.src, Astro.site).href,
  category: p.data.category,
  brand: { "@type": "Brand", name: SHOP.name },
  offers: {
    "@type": "Offer",
    price: p.data.price,
    priceCurrency: "XOF",
    availability: upcoming ? "https://schema.org/PreOrder" : inStock ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
    url,
  },
};
const ROWS = [
  { s: "S", eu: "36", chest: "82–86", waist: "64–68", hips: "90–94" },
  { s: "M", eu: "38", chest: "86–90", waist: "68–72", hips: "94–98" },
  { s: "L", eu: "40", chest: "90–96", waist: "72–78", hips: "98–104" },
  { s: "XL", eu: "42", chest: "96–102", waist: "78–84", hips: "104–110" },
];
---
<Base title={p.data.name} description={`${p.data.name}, ${fcfa(p.data.price)}. ${p.data.description} Commande WhatsApp, paiement à la livraison à Abidjan.`} image={og.src} jsonLd={jsonLd} noindex={upcoming}>
  <nav class="wrap crumbs" aria-label="Fil d'Ariane"><a href="/boutique">Boutique</a> <span aria-hidden="true">/</span> <span>{p.data.category}</span></nav>

  <article class="wrap pd">
    <div class="pd-media">
      <Image src={p.data.image} alt={p.data.name} widths={[390, 476]} sizes="(min-width: 900px) 46vw, 100vw" loading="eager" fetchpriority="high" />
    </div>
    <div class="pd-info">
      <p class="eyebrow">{p.data.category}{p.data.occasion.length > 0 && ` · ${p.data.occasion.join(", ")}`}</p>
      <h1>{p.data.name}</h1>
      <p class="price">{fcfa(p.data.price)}</p>
      <p class="desc">{p.data.description}</p>
      <SizePicker client:load id={p.id} name={p.data.name} price={p.data.price} stock={p.data.stock} url={url} drop={drop} />
      <button type="button" class="ask" data-open-avis>
        <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 5h11a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H9l-4 3v-3H4a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z"/><path d="M19 9h1a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2h-1v3l-4-3h-3"/></svg>
        <span><b>Elle me va ?</b> Demande l'avis d'une copine</span>
        <svg class="ask-go" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
      </button>
      <ul class="reassure">
        <li><b>Paiement à la livraison</b> : tu paies à la réception.</li>
        <li><b>Livraison {SHOP.deliveryDelay}</b> partout à Abidjan.</li>
        <li><b>Essayage possible</b> à la boutique.</li>
      </ul>
    </div>
  </article>

  <section class="wrap guide" id="guide-tailles" aria-labelledby="guide-titre">
    <h2 id="guide-titre">Guide des tailles</h2>
    <p class="muted">Mesures en centimètres. Entre deux tailles, prends la plus grande pour les coupes ajustées.</p>
    <div class="tw">
      <table>
        <thead><tr><th scope="col">Taille</th><th scope="col">EU</th><th scope="col">Poitrine</th><th scope="col">Taille</th><th scope="col">Hanches</th></tr></thead>
        <tbody>{ROWS.map((r) => <tr><th scope="row">{r.s}</th><td>{r.eu}</td><td>{r.chest}</td><td>{r.waist}</td><td>{r.hips}</td></tr>)}</tbody>
      </table>
    </div>
  </section>

  <section class="wrap more" aria-labelledby="look-titre">
    <h2 id="look-titre">Complète le look</h2>
    <div class="more-grid">{related(live, p).map((r) => <ProductCard product={r} />)}</div>
  </section>
  <AvisSheet client:idle current={piece} site={Astro.site!.href} />
</Base>

<style>
  .crumbs { padding-block: 16px 8px; font-size: 13px; color: var(--sourdine-jour); display: flex; gap: 8px; }
  .crumbs a { text-underline-offset: 3px; }
  .pd { display: grid; gap: 24px; padding-bottom: 48px; }
  @media (min-width: 900px) { .pd { grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; } .pd-info { position: sticky; top: 84px; } }
  .pd-media { aspect-ratio: 4 / 5; max-width: 100%; overflow: hidden; border-radius: var(--radius); background: var(--ivoire-2); }
  .pd-media img { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .pd-info { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  h1 { font-size: clamp(34px, 6vw, 52px); }
  .price { font-size: 22px; font-weight: 600; font-variant-numeric: tabular-nums; }
  .desc { color: var(--sourdine-jour); max-width: 52ch; }
  .ask { display: flex; align-items: center; gap: 12px; width: 100%; min-height: 56px; padding: 10px 14px; border-radius: 14px; background: var(--ivoire-2); text-align: left; font-size: 14px; color: var(--cacao); transition: transform 160ms var(--ease-out), background-color 200ms ease; }
  .ask b { display: block; font-family: var(--display); font-weight: 400; font-size: 20px; color: var(--cacao); line-height: 1.1; }
  .ask svg:first-child { color: var(--fuchsia); flex: none; }
  .ask span { flex: 1; }
  .ask-go { flex: none; }
  .ask:active { transform: scale(0.98); }
  @media (hover: hover) and (pointer: fine) { .ask:hover { background: #e8d9ce; } }
  .reassure { list-style: none; padding: 14px 0 0; margin: 0; border-top: 1px solid var(--ligne-jour); display: grid; gap: 6px; font-size: 14px; color: var(--sourdine-jour); }
  .reassure b { color: var(--cacao); font-weight: 600; }
  .guide { padding-block: 32px; display: grid; gap: 10px; }
  .guide h2, .more h2 { font-size: clamp(28px, 5vw, 40px); }
  .tw { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 14px; font-variant-numeric: tabular-nums; }
  th, td { text-align: left; padding: 10px 8px; border-bottom: 1px solid var(--ligne-jour); white-space: nowrap; }
  thead th { font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--sourdine-jour); font-weight: 600; }
  .more { padding-block: 32px 72px; display: grid; gap: 18px; }
  .more-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 12px; }
  @media (min-width: 900px) { .more-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 32px 20px; } }
</style>
