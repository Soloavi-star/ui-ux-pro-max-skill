---
import { Image } from "astro:assets";
import type { Product } from "../lib/catalog";
import { fcfa, isSoldOut, lastPieces } from "../lib/shop";

interface Props { product: Product; eager?: boolean }
const { product: p, eager = false } = Astro.props;
const soldOut = isSoldOut(p.data.stock);
const last = lastPieces(p.data.stock);
---
<article class="pc" data-cat={p.data.category} data-occ={p.data.occasion.join(",")}>
  <a href={`/produit/${p.id}`} class="pc-link">
    <div class="pc-ph">
      <Image src={p.data.image} alt={p.data.name} widths={[240, 360, 476]} sizes="(min-width: 1024px) 270px, (min-width: 700px) 30vw, 46vw" loading={eager ? "eager" : "lazy"} />
      <div class="pc-tags">
        {p.data.isNew && <span class="tag">Nouveau</span>}
        {soldOut ? <span class="tag out">Épuisé</span> : last.length > 0 && <span class="tag warn">Dernière en {last.join(", ")}</span>}
      </div>
    </div>
    <span class="pc-name">{p.data.name}</span>
    <span class="pc-price">{fcfa(p.data.price)}</span>
  </a>
</article>

<style>
  .pc { min-width: 0; }
  .pc-link { display: flex; flex-direction: column; gap: 4px; text-decoration: none; }
  .pc-ph { position: relative; aspect-ratio: 3 / 4; max-width: 100%; overflow: hidden; border-radius: var(--radius); background: var(--ivoire-2); margin-bottom: 6px; }
  .pc-ph img { width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform 500ms var(--ease-out); }
  .pc-tags { position: absolute; left: 8px; top: 8px; right: 8px; display: flex; flex-wrap: wrap; gap: 4px; }
  .tag { font-size: 11px; font-weight: 600; padding: 4px 8px; border-radius: 999px; background: var(--ivoire); color: var(--cacao); }
  .tag.warn { background: var(--fuchsia); color: var(--ivoire); }
  .tag.out { background: var(--cacao); color: var(--ivoire); }
  .pc-name { font-weight: 500; font-size: 15px; line-height: 1.35; }
  .pc-price { font-size: 14px; color: var(--sourdine-jour); font-variant-numeric: tabular-nums; }
  @media (hover: hover) and (pointer: fine) { .pc-link:hover img { transform: scale(1.04); } }
</style>
