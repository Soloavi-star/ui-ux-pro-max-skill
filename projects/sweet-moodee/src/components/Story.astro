---
// "Samedi soir": a chat between two friends, driven by scroll, that ends when
// the shared link card grows into the shop. Plain JS, no library.
import { Image } from "astro:assets";
import mariam from "../assets/products/a00.jpg";
import w1 from "../assets/products/b22.jpg";
import w2 from "../assets/products/a12.jpg";
import w3 from "../assets/products/a21.jpg";

const tick = `<svg width="16" height="11" viewBox="0 0 16 11" fill="none" stroke="#E2B970" stroke-width="1.6" aria-hidden="true"><path d="M1 6l3 3 6-7M6 8l1 1 6-7"/></svg>`;
const wall = [w1, w2, w3];
---
<section class="st" id="histoire" aria-label="Histoire : une conversation entre deux amies avant samedi soir">
  <div class="st-stage" data-stage>
    <div class="st-progress" data-progress></div>
    <div class="st-bokeh" style="width:220px;height:220px;left:6%;top:18%;background:var(--fuchsia)"></div>
    <div class="st-bokeh" style="width:160px;height:160px;right:8%;top:58%;background:var(--champagne)"></div>

    <div class="st-side" aria-hidden="true">
      <div class="st-chap-big" data-chap-big>Jeudi, 22 h 14</div>
      <div class="st-line" data-line>Toutes les filles ont déjà envoyé ce message.</div>
    </div>

    <div class="st-phone" data-phone>
      <div class="st-app kb-on" data-app>
        <div class="st-hd">
          <div class="st-av" aria-hidden="true">M</div>
          <div class="st-who"><b>Mariam</b><span class="st-status" data-status>en ligne</span></div>
          <a class="st-skip" href="#nouveautes" data-skip>Passer l'histoire</a>
        </div>
        <div class="st-chap" data-chap aria-hidden="true">Jeudi, 22 h 14</div>
        <div class="st-hint" data-hint aria-hidden="true"><span></span>Fais défiler pour lire</div>

        <div class="st-msgs" role="log" aria-label="Conversation avec Mariam">
          <div class="st-b in" data-at="0"><div>Tu dors déjà ?</div><div class="st-meta">22:13</div></div>
          <div class="st-b out" data-at=".14" hidden><div>Samedi c'est l'anniv d'Aïcha 🎉 on sort où ?</div><div class="st-meta">22:14 <Fragment set:html={tick} /></div></div>
          <div class="st-dots" data-at=".16" data-until=".22" hidden aria-label="Mariam écrit"><i></i><i></i><i></i></div>
          <div class="st-b in" data-at=".22" hidden><div>Rooftop au Plateau 🔥 dress code chic hein ! Faut qu'on soit trop belles</div><div class="st-meta">22:15</div></div>
          <div class="st-b in" data-at=".28" hidden><div>Tu mets quoi toi ?</div><div class="st-meta">Ven. 23:38</div></div>
          <div class="st-b out big" data-at=".415" hidden><div>J'ai RIEN à me mettre 😭😭</div><div class="st-meta">23:41 <Fragment set:html={tick} /></div></div>
          <div class="st-dots" data-at=".43" data-until=".48" hidden aria-label="Mariam écrit"><i></i><i></i><i></i></div>
          <div class="st-b in media" data-at=".48" hidden>
            <Image src={mariam} alt="Mariam en robe noire, en soirée" widths={[250, 476]} sizes="250px" loading="eager" />
            <div class="st-cap">Va chez Sweet Moodee !! C'est là que j'ai pris ma robe pour l'anniv de Fatou 😍</div>
            <div class="st-meta">23:42</div>
          </div>
          <div class="st-b out" data-at=".55" hidden><div>Elle est trop belle 😍 c'est où ?</div><div class="st-meta">23:43 <Fragment set:html={tick} /></div></div>
          <div class="st-dots" data-at=".57" data-until=".62" hidden aria-label="Mariam écrit"><i></i><i></i><i></i></div>
          <div class="st-b in card" data-at=".62" hidden>
            <a class="st-lk" href="/boutique" data-card>
              <span class="st-strip">{wall.map((w) => <Image src={w} alt="" widths={[120, 240]} sizes="90px" />)}</span>
              <span class="st-lt"><b>Sweet Moodee · Mode femme à Abidjan</b><span>Robes, combinaisons, ensembles. Commande sur WhatsApp, paiement à la livraison.</span><em>sweetmoodee.com</em></span>
            </a>
            <div class="st-cap">Ils livrent partout à Abidjan et tu paies à la livraison 👌</div>
            <div class="st-meta">23:44</div>
            <div class="st-tap" data-tap hidden></div>
          </div>
        </div>

        <div class="st-cmp" aria-hidden="true">
          <div class="st-field" data-field><span class="ph">Message</span></div>
          <div class="st-send">
            <span data-ico-send hidden><svg viewBox="0 0 24 24" fill="none" stroke="#F7EEE7" stroke-width="2"><path d="M4 12l16-8-6 16-3-7z"/></svg></span>
            <span data-ico-mic><svg viewBox="0 0 24 24" fill="none" stroke="#F7EEE7" stroke-width="1.8"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/></svg></span>
          </div>
        </div>
        <div class="st-kb" aria-hidden="true"><div class="st-kb-in" data-kb></div></div>
      </div>
    </div>

    <div class="st-site" data-site>
      <div class="st-wall">{wall.map((w) => <Image src={w} alt="" widths={[480]} sizes="34vw" loading="eager" />)}</div>
      <div class="st-veil"></div>
      <div class="st-site-in" data-site-in>
        <div class="st-logo">Sweet <em>Moodee</em></div>
        <div class="st-hero">
          <p class="st-eyebrow">Abidjan · Mode femme</p>
          <h1>Samedi commence ici.</h1>
          <p>Robes, combinaisons et ensembles. Commande en un message, paiement à la livraison.</p>
          <div class="st-ctas">
            <a class="btn btn-main" href="/boutique">Trouver ma tenue</a>
            <a class="btn st-ghost" href="#nouveautes">Nouveautés</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.getElementById("histoire")!;
  const $ = <T extends Element = HTMLElement>(s: string) => root.querySelector(s) as T;
  const stage = $("[data-stage]"), app = $("[data-app]"), field = $("[data-field]"), status = $("[data-status]");
  const chap = $("[data-chap]"), chapBig = $("[data-chap-big]"), line = $("[data-line]"), hint = $("[data-hint]");
  const bar = $("[data-progress]"), site = $("[data-site]"), siteIn = $("[data-site-in]"), card = $("[data-card]"), tap = $("[data-tap]");
  const icoSend = $("[data-ico-send]"), icoMic = $("[data-ico-mic]");
  const items = Array.from(root.querySelectorAll<HTMLElement>(".st-msgs [data-at]"));

  // AZERTY keyboard, built once
  const kb = $("[data-kb]");
  const row = (keys: string) => keys.split("").map((k) => `<div class="k" data-k="${k}">${k}</div>`).join("");
  kb.innerHTML = `<div class="row">${row("azertyuiop")}</div><div class="row">${row("qsdfghjklm")}</div>` +
    `<div class="row"><div class="k mod">⇧</div>${row("wxcvbn")}<div class="k mod">⌫</div></div>` +
    `<div class="row"><div class="k mod">123</div><div class="k" data-k=",">,</div><div class="k space" data-k=" ">espace</div><div class="k" data-k=".">.</div><div class="k mod">↵</div></div>`;
  const keys: Record<string, HTMLElement> = {};
  kb.querySelectorAll<HTMLElement>("[data-k]").forEach((k) => (keys[k.dataset.k!] = k));
  const keyFor = (ch?: string) => {
    if (!ch) return null;
    const c = ch.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "");
    return keys[c] ? c : null;
  };

  // Timeline, in scroll progress (0 → 1)
  const TYPE = [
    { from: 0.02, to: 0.125, sent: 0.14, text: "Samedi c'est l'anniv d'Aïcha 🎉 on sort où ?" },
    { from: 0.3, to: 0.395, sent: 0.415, text: "J'ai RIEN à me mettre 😭😭" },
  ];
  const KB_ON: [number, number][] = [[0, 0.14], [0.29, 0.415]];
  const TYPING: [number, number][] = [[0.16, 0.22], [0.43, 0.48], [0.57, 0.62]];
  const LINES: [number, string][] = [
    [0, "Toutes les filles ont déjà envoyé ce message."], [0.15, "Il faut être belle samedi."],
    [0.29, "Et comme toujours…"], [0.43, "Heureusement, il y a Mariam."],
    [0.6, "Un lien. Et on paie à la livraison."], [0.74, ""],
  ];
  const TAP: [number, number] = [0.68, 0.76];
  const EXPAND: [number, number] = [0.76, 0.9];

  const clamp = (v: number) => Math.max(0, Math.min(1, v));
  const inRange = (p: number, r: [number, number]) => p >= r[0] && p < r[1];
  const easeInOut = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
  let lastP = -1, lastText: string | null = null, lastKey: string | null = null;

  function render(p: number) {
    if (Math.abs(p - lastP) < 0.0004) return;
    lastP = p;
    bar.style.transform = `scaleX(${p})`;
    hint.style.opacity = p < 0.012 ? "1" : "0";
    document.body.classList.toggle("story-done", p >= 0.995);

    for (const el of items) {
      const at = parseFloat(el.dataset.at!), until = el.dataset.until ? parseFloat(el.dataset.until) : 2;
      const show = p >= at && p < until;
      if (el.hidden === show) el.hidden = !show;
    }

    let text = "", key: string | null = null;
    for (const s of TYPE) {
      const chars = Array.from(s.text);
      if (p >= s.from && p < s.to) {
        const n = Math.round(clamp((p - s.from) / (s.to - s.from)) * chars.length);
        text = chars.slice(0, n).join("");
        key = keyFor(chars[Math.max(0, n - 1)]);
      } else if (p >= s.to && p < s.sent) text = s.text;
    }
    if (text !== lastText) {
      field.textContent = text || "";
      if (text) { const c = document.createElement("span"); c.className = "caret"; field.append(c); }
      else field.innerHTML = '<span class="ph">Message</span>';
      icoSend.toggleAttribute("hidden", !text); icoMic.toggleAttribute("hidden", !!text);
      lastText = text;
    }
    if (key !== lastKey) {
      if (lastKey) keys[lastKey]?.classList.remove("on");
      if (key) keys[key]?.classList.add("on");
      lastKey = key;
    }
    app.classList.toggle("kb-on", KB_ON.some((r) => inRange(p, r)));

    const typing = TYPING.some((r) => inRange(p, r));
    status.textContent = typing ? "écrit…" : "en ligne";
    status.classList.toggle("typing", typing);
    const c = p < 0.26 ? "Jeudi, 22 h 14" : "Vendredi, 23 h 40";
    if (chap.textContent !== c) { chap.textContent = c; chapBig.textContent = c; }
    let l = ""; for (const [at, t] of LINES) if (p >= at) l = t;
    if (line.textContent !== l) line.textContent = l;
    tap.hidden = !inRange(p, TAP);

    // The link card grows until it becomes the shop's opening screen
    if (p < EXPAND[0]) { site.style.visibility = "hidden"; return; }
    const t = easeInOut(clamp((p - EXPAND[0]) / (EXPAND[1] - EXPAND[0])));
    const s = stage.getBoundingClientRect(), r = card.getBoundingClientRect();
    const k = 1 - t;
    site.style.visibility = "visible";
    site.style.clipPath = `inset(${(r.top - s.top) * k}px ${(s.right - r.right) * k}px ${(s.bottom - r.bottom) * k}px ${(r.left - s.left) * k}px round ${11 * k}px)`;
    const o = clamp((t - 0.45) / 0.45);
    siteIn.style.opacity = String(o);
    siteIn.style.transform = `translateY(${(1 - o) * 14}px)`;
    siteIn.style.visibility = o > 0.01 ? "visible" : "hidden";
  }

  const progress = () => {
    const r = root.getBoundingClientRect(), span = root.offsetHeight - innerHeight;
    return span > 0 ? clamp(-r.top / span) : 1;
  };
  const fit = () => $("[data-phone]").style.setProperty("--s", Math.min(1, (innerHeight - 48) / 844).toFixed(3));
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

  fit();
  if (reduce) {
    root.classList.add("st-static");
    document.body.classList.add("story-done");
    render(0.7);
  } else {
    let ticking = false;
    addEventListener("scroll", () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => { ticking = false; render(progress()); });
    }, { passive: true });
    render(progress());
  }
  addEventListener("resize", () => { fit(); lastP = -1; render(reduce ? 0.7 : progress()); });
  // Skip: land at the end of the story, on the shop's opening screen
  $("[data-skip]").addEventListener("click", (e) => {
    e.preventDefault();
    scrollTo({ top: root.offsetTop + root.offsetHeight - innerHeight, behavior: reduce ? "auto" : "smooth" });
  });
</script>

<style is:global>
  .st { position: relative; height: 760vh; background: var(--nuit); color: var(--ivoire); }
  .st.st-static { height: auto; }
  .st-stage { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; background: var(--nuit); }
  .st-static .st-stage { position: relative; }
  .st-progress { position: absolute; left: 0; right: 0; top: 0; height: 2px; background: var(--champagne); transform-origin: left; transform: scaleX(0); z-index: 6; }
  .st-bokeh { position: absolute; border-radius: 50%; filter: blur(40px); opacity: 0.35; pointer-events: none; }
  .st-phone { position: absolute; inset: 0; display: flex; }
  .st-app { position: relative; flex: 1; display: flex; flex-direction: column; background: var(--nuit); overflow: hidden; }
  .st-hd { display: flex; align-items: center; gap: 10px; padding: calc(12px + env(safe-area-inset-top, 0px)) 12px 12px; background: var(--velours-2); border-bottom: 1px solid rgba(247, 238, 231, 0.08); position: relative; z-index: 2; }
  .st-av { width: 38px; height: 38px; border-radius: 50%; background: var(--fuchsia); display: grid; place-items: center; font-weight: 600; flex: none; }
  .st-who { display: flex; flex-direction: column; flex: 1; min-width: 0; }
  .st-who b { font-weight: 600; font-size: 16px; }
  .st-status { font-size: 12px; color: var(--sourdine); }
  .st-status.typing { color: var(--fuchsia-nuit); }
  .st-skip { font-size: 12px; font-weight: 600; padding: 0 12px; min-height: 36px; display: inline-flex; align-items: center; border-radius: 18px; border: 1px solid rgba(247, 238, 231, 0.3); text-decoration: none; white-space: nowrap; transition: transform 160ms var(--ease-out); }
  .st-skip:active { transform: scale(0.96); }
  .st-chap { align-self: center; margin-top: 16px; font-family: var(--display); font-size: 24px; color: var(--champagne); }
  .st-hint { align-self: center; margin-top: 10px; font-size: 12px; color: var(--sourdine); display: flex; gap: 8px; align-items: center; transition: opacity 300ms ease; }
  .st-hint span { display: block; width: 1px; height: 22px; background: linear-gradient(var(--champagne), transparent); animation: st-drip 1.6s ease-in-out infinite; transform-origin: top; }
  @keyframes st-drip { 0% { transform: scaleY(0); } 60% { transform: scaleY(1); opacity: 1; } 100% { transform: scaleY(1); opacity: 0; } }
  .st-msgs { flex: 1; min-height: 0; display: flex; flex-direction: column; justify-content: flex-end; gap: 6px; padding: 8px 12px 10px; overflow: hidden; }
  .st-b { max-width: 80%; border-radius: 14px; padding: 7px 10px 6px; font-size: 15px; line-height: 1.38; transition: opacity 180ms ease, transform 220ms var(--ease-out); transform-origin: bottom left; }
  .st-b.in { align-self: flex-start; background: var(--velours); border-top-left-radius: 4px; }
  .st-b.out { align-self: flex-end; background: var(--message); border-top-right-radius: 4px; transform-origin: bottom right; }
  .st-b.big { font-size: 17px; font-weight: 600; }
  .st-meta { display: flex; justify-content: flex-end; align-items: center; gap: 4px; font-size: 11px; color: rgba(247, 238, 231, 0.62); margin-top: 2px; font-variant-numeric: tabular-nums; }
  .st-b.media { padding: 4px; width: 250px; }
  .st-b.media img { width: 100%; height: 280px; object-fit: cover; object-position: top; border-radius: 11px; transition: filter 700ms ease; }
  .st-cap { padding: 6px 6px 0; }
  .st-b.media .st-meta, .st-b.card .st-meta { padding: 0 6px 2px; }
  @starting-style { .st-b { opacity: 0; transform: translateY(8px) scale(0.96); } .st-b.media img { filter: blur(14px); } }
  .st-dots { align-self: flex-start; background: var(--velours); border-radius: 14px; border-top-left-radius: 4px; padding: 12px 14px; display: flex; gap: 5px; }
  .st-dots i { width: 7px; height: 7px; border-radius: 50%; background: var(--sourdine); animation: st-dot 1.2s infinite ease-in-out; }
  .st-dots i:nth-child(2) { animation-delay: 0.15s; }
  .st-dots i:nth-child(3) { animation-delay: 0.3s; }
  @keyframes st-dot { 0%, 60%, 100% { transform: translateY(0); opacity: 0.5; } 30% { transform: translateY(-4px); opacity: 1; } }
  .st-b.card { width: 272px; max-width: 84%; padding: 4px; position: relative; }
  .st-lk { background: var(--velours-2); border-radius: 11px; overflow: hidden; display: flex; flex-direction: column; text-decoration: none; }
  .st-strip { height: 150px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2px; }
  .st-strip img { width: 100%; height: 150px; object-fit: cover; object-position: top; }
  .st-lt { padding: 9px 11px 11px; display: flex; flex-direction: column; gap: 2px; }
  .st-lt b { font-weight: 600; font-size: 14px; }
  .st-lt span { font-size: 12.5px; color: var(--sourdine); line-height: 1.35; }
  .st-lt em { font-style: normal; font-size: 12px; color: var(--fuchsia-nuit); }
  .st-tap { position: absolute; left: 50%; top: 80px; width: 64px; height: 64px; margin-left: -32px; border-radius: 50%; border: 2px solid var(--ivoire); background: rgba(247, 238, 231, 0.16); animation: st-tap 900ms var(--ease-out) infinite; pointer-events: none; }
  @keyframes st-tap { from { transform: scale(0.7); opacity: 1; } to { transform: scale(1.25); opacity: 0; } }
  .st-cmp { display: flex; align-items: flex-end; gap: 8px; padding: 8px 10px; background: var(--nuit); position: relative; z-index: 2; }
  .st-field { flex: 1; min-width: 0; min-height: 44px; border-radius: 22px; background: var(--velours); padding: 11px 14px; font-size: 15px; line-height: 1.38; overflow-wrap: anywhere; }
  .st-field .ph { color: var(--sourdine); }
  .st-field .caret { display: inline-block; width: 2px; height: 18px; background: var(--fuchsia-nuit); vertical-align: -3px; margin-left: 1px; animation: st-blink 1s steps(1) infinite; }
  @keyframes st-blink { 50% { opacity: 0; } }
  .st-send { width: 44px; height: 44px; flex: none; border-radius: 50%; background: var(--message); display: grid; place-items: center; }
  .st-send span { display: grid; }
  .st-send svg { width: 20px; height: 20px; }
  .st-kb { height: 0; overflow: hidden; background: var(--velours-2); transition: height 260ms var(--ease-out); position: relative; z-index: 2; }
  .st-app.kb-on .st-kb { height: calc(226px + env(safe-area-inset-bottom, 0px)); }
  .st-kb-in { padding: 10px 3px 14px; display: flex; flex-direction: column; gap: 10px; }
  .st-kb .row { display: flex; justify-content: center; gap: 5px; }
  .st-kb .k { flex: 0 1 34px; height: 42px; border-radius: 6px; background: #3a2631; display: grid; place-items: center; font-size: 17px; color: var(--ivoire); transition: transform 80ms var(--ease-out), background-color 80ms ease; }
  .st-kb .k.mod { flex-basis: 46px; background: #2a1a23; font-size: 14px; }
  .st-kb .k.space { flex: 0 1 180px; font-size: 13px; color: var(--sourdine); }
  .st-kb .k.on { background: var(--ivoire); color: var(--nuit); transform: translateY(-8px) scale(1.16); }
  .st-kb .k.space.on { transform: translateY(-3px) scale(1.03); }
  .st-site { position: absolute; inset: 0; z-index: 5; visibility: hidden; background: var(--nuit); clip-path: inset(50% 50% 50% 50% round 14px); }
  .st-static .st-site { display: none; }
  .st-wall { position: absolute; inset: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2px; }
  .st-wall img { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .st-veil { position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(18, 11, 16, 0.55) 0%, rgba(18, 11, 16, 0) 22%, rgba(18, 11, 16, 0) 38%, rgba(18, 11, 16, 0.94) 72%); }
  .st-site-in { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: space-between; padding: calc(16px + env(safe-area-inset-top, 0px)) 18px calc(28px + env(safe-area-inset-bottom, 0px)); }
  .st-logo { font-family: var(--display); font-size: 24px; text-shadow: 0 1px 12px rgba(18, 11, 16, 0.8); }
  .st-logo em { font-style: normal; color: var(--fuchsia-nuit); }
  .st-hero { display: flex; flex-direction: column; gap: 12px; max-width: 560px; }
  .st-eyebrow { font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; font-weight: 600; color: var(--champagne); }
  .st-hero h1 { font-size: clamp(44px, 12vw, 92px); line-height: 0.96; }
  .st-hero p:not(.st-eyebrow) { font-size: 15px; color: #e1d3d8; max-width: 42ch; }
  .st-ctas { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 4px; }
  .st-ctas .btn-main { flex: 1; min-width: 180px; }
  .st-ghost { border: 1px solid rgba(247, 238, 231, 0.45); color: var(--ivoire); }
  .st-side { display: none; }
  @media (min-width: 760px) {
    .st-phone { inset: auto; left: 50%; top: 50%; width: 390px; height: 844px; margin: -422px 0 0 -195px; transform: scale(var(--s, 1)); border-radius: 46px; border: 9px solid #2a1a23; box-shadow: 0 40px 90px rgba(0, 0, 0, 0.6); overflow: hidden; z-index: 2; }
    .st-app .st-chap { display: none; }
    .st-hd { padding-top: 16px; }
