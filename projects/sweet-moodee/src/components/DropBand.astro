---
// Boutique: a slim reminder of the coming drop, linking to its section on the home page.
import { getNextDrop } from "../lib/catalog";

const drop = await getNextDrop();
const n = drop?.pieces.length ?? 0;
---
{drop && n > 0 && (
  <a class="band" href="/#drop" data-drop data-drop-at={drop.at.toISOString()} data-pieces={n}>
    <span class="band-k">Le drop du vendredi</span>
    <span class="swap band-t">
      <span data-before>{n} nouvelles pièces · encore <b data-cd-text>…</b></span>
      <span data-after>{n} nouvelles pièces sont en ligne</span>
    </span>
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
  </a>
)}

<script>
  import "../scripts/drop";
</script>

<style>
  .band { display: flex; align-items: center; gap: 12px; padding: 12px 16px; border-radius: 14px; background: var(--nuit); color: var(--ivoire); text-decoration: none; transition: transform 160ms var(--ease-out); }
  .band:active { transform: scale(0.98); }
  .band-k { font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; font-weight: 600; color: var(--champagne); max-width: 9em; line-height: 1.3; }
  .band-t { flex: 1; font-size: 14px; }
  .band-t b { font-weight: 600; font-variant-numeric: tabular-nums; }
  .band svg { flex: none; }
</style>
